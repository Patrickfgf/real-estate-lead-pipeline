# ============================================================
# Projeto Jaré — variáveis de ambiente (stack Python)
# Copiar para .env e preencher. NUNCA commitar o .env real.
# ============================================================

# ---------- App / FastAPI ----------
# Host e porta onde o webhook FastAPI escuta (Caddy/reverse-proxy faz o HTTPS na frente).
APP_HOST=0.0.0.0
APP_PORT=8000
TZ=America/Sao_Paulo

# ---------- Banco (DuckDB) ----------
# Caminho do arquivo .duckdb. Fica em data/ (já ignorado pelo git).
DUCKDB_PATH=data/jare.duckdb

# ---------- Wimóveis (webhook oficial — recebe POST) ----------
# Segredo compartilhado para validar que o POST veio mesmo do portal.
# A Navent envia este valor de volta no header que NÓS escolhemos ao cadastrar
# o callback (ver src/navent.py). Gerar com: openssl rand -hex 32
WIMOVEIS_WEBHOOK_SECRET=cole-aqui-um-segredo-aleatorio

# ---------- Navent Open API (cadastro do callback de leads) ----------
# Base: sandbox = https://api-br-sandbox-open.navent.com | produção = https://api-br-open.navent.com
NAVENT_BASE_URL=https://api-br-sandbox-open.navent.com
# TOKEN para chamar a API da Navent. Gere no playground (ver vídeo Loom) e cole aqui.
NAVENT_TOKEN=
# (Opcional) usuário/senha para o login automático best-effort (python -m src.navent login)
NAVENT_USER=
NAVENT_PASSWORD=
# URL pública do NOSSO webhook (o túnel cloudflared agora, ou o domínio do VPS depois).
# SEM barra no final. Ex.: https://reporters-scotia-filter-die.trycloudflare.com
WEBHOOK_PUBLIC_URL=

# ---------- DFImóveis (API oficial — polling com token) ----------
DFIMOVEIS_API_URL=https://www.dfimoveis.com.br/api/leads
DFIMOVEIS_API_TOKEN=cole-aqui-o-token-do-dfimoveis
# Intervalo de polling em segundos (ex.: 300 = 5 min)
DFIMOVEIS_POLL_INTERVAL=300

# ---------- Trello (cria os cards dos leads) ----------
# Key/token em https://trello.com/app-key
TRELLO_API_KEY=cole-aqui-a-key
TRELLO_API_TOKEN=cole-aqui-o-token
# ID da lista onde os novos leads entram (ex.: "Novos leads")
TRELLO_LIST_ID=cole-aqui-o-id-da-lista
# ID da etiqueta de origem "Wimóveis" (rode: python -m src.trello setup)
TRELLO_LABEL_WIMOVEIS=cole-aqui-o-id-da-etiqueta
