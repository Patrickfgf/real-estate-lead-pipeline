# ============================================================
# Projeto Jaré — variáveis de ambiente do n8n
# Copiar para .env e preencher. NUNCA commitar o .env real.
# ============================================================

# Domínio onde o n8n vai responder (precisa apontar para o IP da VPS)
N8N_HOST=n8n.seudominio.com.br

# Postgres
POSTGRES_USER=n8n
POSTGRES_PASSWORD=trocar-por-senha-forte-aleatoria
POSTGRES_DB=n8n

# Chave de criptografia das credenciais salvas no n8n.
# Gerar com: openssl rand -hex 32
# CUIDADO: se perder essa chave, todas as credenciais salvas viram lixo.
N8N_ENCRYPTION_KEY=cole-aqui-uma-string-aleatoria-de-64-chars

# Login adicional do editor (camada extra antes do login do próprio n8n)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=trocar-por-senha-forte
