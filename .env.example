# ============================================================
# Projeto Jaré — variáveis de ambiente (stack Python)
# Copiar para .env e preencher. NUNCA commitar o .env real.
# ============================================================

# ---------- App / FastAPI ----------
# Host e porta onde o webhook FastAPI escuta (Caddy/reverse-proxy faz o HTTPS na frente).
APP_HOST=0.0.0.0
APP_PORT=8000
TZ=America/Sao_Paulo

# ---------- Banco (DuckDB) ----------
# Caminho do arquivo .duckdb. Fica em data/ (já ignorado pelo git).
DUCKDB_PATH=data/jare.duckdb

# ---------- Wimóveis (webhook oficial — recebe POST) ----------
# Segredo compartilhado para validar que o POST veio mesmo do portal.
# A Navent envia este valor de volta no header que NÓS escolhemos ao cadastrar
# o callback (ver src/navent.py). Gerar com: openssl rand -hex 32
WIMOVEIS_WEBHOOK_SECRET=cole-aqui-um-segredo-aleatorio

# ---------- Navent Open API (cadastro do callback de leads) ----------
# Base: sandbox = https://api-br-sandbox-open.navent.com | produção = https://api-br-open.navent.com
NAVENT_BASE_URL=https://api-br-sandbox-open.navent.com
# TOKEN para chamar a API da Navent. Gere no playground (ver vídeo Loom) e cole aqui.
NAVENT_TOKEN=
# (Opcional) usuário/senha para o login automático best-effort (python -m src.navent login)
NAVENT_USER=
NAVENT_PASSWORD=
# URL pública do NOSSO webhook (o túnel cloudflared agora, ou o domínio do VPS depois).
# SEM barra no final. Ex.: https://reporters-scotia-filter-die.trycloudflare.com
WEBHOOK_PUBLIC_URL=

# ---------- DFImóveis (webhook oficial — padrão VrSync, recebe POST) ----------
# A DFImóveis faz POST do lead na nossa URL. O token é combinado no cadastro e
# enviado na URL (?token=) ou no header x-webhook-token. Gerar: openssl rand -hex 32
DFIMOVEIS_WEBHOOK_SECRET=cole-aqui-um-segredo-aleatorio

# ---------- Trello (cria os cards dos leads) ----------
# Key/token em https://trello.com/app-key
TRELLO_API_KEY=cole-aqui-a-key
TRELLO_API_TOKEN=cole-aqui-o-token
# ID da lista onde os novos leads entram (ex.: "Novos leads")
TRELLO_LIST_ID=cole-aqui-o-id-da-lista
# ID da etiqueta de origem "Wimóveis" (rode: python -m src.trello setup)
TRELLO_LABEL_WIMOVEIS=cole-aqui-o-id-da-etiqueta
# ID da etiqueta de origem "DFImóveis" (rode: python -m src.trello setup)
TRELLO_LABEL_DFIMOVEIS=cole-aqui-o-id-da-etiqueta
# IDs das etiquetas de TEMPERATURA do lead (Fase 3 — scoring). Geradas junto com
# as de origem por: python -m src.trello setup
TRELLO_LABEL_QUENTE=cole-aqui-o-id-da-etiqueta
TRELLO_LABEL_MORNO=cole-aqui-o-id-da-etiqueta
TRELLO_LABEL_FRIO=cole-aqui-o-id-da-etiqueta
# Nomes do quadro e da área de trabalho (usados por: python -m src.trello setup).
# Em produção, coloque o nome real do cliente; genérico por padrão.
# TRELLO_LIST_ID + TRELLO_BOARD_NAME acima são o quadro ÚNICO (fallback) — usado
# para leads de transaction_type None (ex.: Wimóveis quando a Navent não resolveu).
TRELLO_WORKSPACE_NAME=Leads CRM
TRELLO_BOARD_NAME=Leads — Imobiliária

# ---------- Trello — roteamento por 2 quadros (Fase 2: Compra vs Locação) ----------
# Cada card vai para o quadro do seu transaction_type: Compra → quadro de Compra,
# Aluguel → quadro de Locação. ROLLOUT SEGURO: enquanto TRELLO_LIST_ID_COMPRA/_ALUGUEL
# estiverem vazios, o roteamento fica INATIVO e TUDO cai no quadro único (TRELLO_LIST_ID).
# Rode `python -m src.trello setup` para criar os 2 quadros e gerar os IDs abaixo.
TRELLO_BOARD_NAME_COMPRA=Leads — Compra
TRELLO_BOARD_NAME_ALUGUEL=Leads — Locação
# Listas de entrada de cada quadro (é o list id que ATIVA o roteamento do tipo).
TRELLO_LIST_ID_COMPRA=
TRELLO_LIST_ID_ALUGUEL=
# Etiquetas POR-QUADRO (um id de etiqueta pertence a UM quadro só). Quadro de Compra:
TRELLO_LABEL_WIMOVEIS_COMPRA=
TRELLO_LABEL_DFIMOVEIS_COMPRA=
TRELLO_LABEL_QUENTE_COMPRA=
TRELLO_LABEL_MORNO_COMPRA=
TRELLO_LABEL_FRIO_COMPRA=
# Quadro de Locação (Aluguel):
TRELLO_LABEL_WIMOVEIS_ALUGUEL=
TRELLO_LABEL_DFIMOVEIS_ALUGUEL=
TRELLO_LABEL_QUENTE_ALUGUEL=
TRELLO_LABEL_MORNO_ALUGUEL=
TRELLO_LABEL_FRIO_ALUGUEL=
